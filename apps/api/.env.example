# Local default. SQLite requires no external credentials.
LEADERBOARD_STORAGE=sqlite
API_HOST=127.0.0.1
API_PORT=3002

# After applying supabase/migrations/202609290001_leaderboard.sql, switch to Supabase.
# Keep the Supabase secret key on the API server only. Never prefix it with VITE_.
# LEADERBOARD_STORAGE=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_me
