{
  "name": "@motion-runner/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets": "bun scripts/prepare-assets.mjs",
    "predev": "bun run assets",
    "prebuild": "bun run assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "test:race": "playwright test --config playwright.race.config.ts",
    "check": "bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@motion-runner/game": "workspace:*",
    "blobatar": "2.7.0",
    "motion": "13.4.4",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "three.quarks": "0.17.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
